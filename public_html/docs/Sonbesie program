                                                                     
                                                                     
                                                                     
                                             
'CR1000 Series
'Created by Short Cut (2.8)

'Declare Variables and Units
Public BattV
Public TrackerWM
Public Tracker2WM
Public TrackerKJ
Public Tracker2KJ
Public ShadowWM
Public ShadowKJ
Public SunWM
Public SunKJ
Public ShadowbandWM
Public ShadowbandKJ
Public Temp_TypeT
Public BP_mB
Public PTemp
Public PushButton
Public GateEntry
Public TRHData(2)
Public WS_ms
Public WindDir

Alias TRHData(1)=AirTC
Alias TRHData(2)=RH

Units BattV=Volts
Units TrackerWM=kW/m^2
Units TrackerKJ=kJ/m^2
Units ShadowWM=kW/m^2
Units ShadowKJ=kJ/m^2
Units SunWM=W/m^2
Units SunKJ=kJ/m^2
Units ShadowbandWM=W/m^2
Units ShadowbandKJ=kJ/m^2
Units WS_ms=meters/second
Units WindDir=Degrees
Units AirTC=Deg C
Units RH=%

'Define Data Tables
DataTable(TMin,True,-1)
	DataInterval(0,60,Sec,10)
	Average(1,TrackerWM,IEEE4,False)
	Average(1,Tracker2WM,IEEE4,False)
	Average(1,ShadowWM,IEEE4,False)
	Average(1,SunWM,IEEE4,False)
	Average(1,ShadowbandWM,IEEE4,False)
	Average(1,AirTC,FP2,False)
	Sample(1,RH,FP2)
	WindVector(1,WS_ms,WindDir,FP2,False,0,0,0)
	FieldNames("WS_ms_S_WVT,WindDir_D1_WVT,WindDir_SD1_WVT")
	Average(1,BP_mB,FP2,False)
EndTable

DataTable(THour,True,-1)
	DataInterval(0,60,Min,10)
	Minimum(1,BattV,FP2,False,False)
	Average(1,TrackerWM,IEEE4,False)
	Average(1,Tracker2WM,IEEE4,False)
	Average(1,ShadowWM,IEEE4,False)
	Average(1,SunWM,IEEE4,False)
	Average(1,ShadowbandWM,IEEE4,False)
	Average(1,AirTC,FP2,False)
	Sample(1,RH,FP2)
	WindVector(1,WS_ms,WindDir,FP2,False,0,0,0)
	FieldNames("WS_ms_S_WVT,WindDir_D1_WVT,WindDir_SD1_WVT")
	Average(1,BP_mB,FP2,False)
EndTable

DataTable(TDaily,True,-1)
	DataInterval(0,1440,Min,10)
	Totalize(1,TrackerKJ,IEEE4,False)
	Totalize(1,Tracker2KJ,IEEE4,False)
	Totalize(1,ShadowKJ,IEEE4,False)
	Totalize(1,SunKJ,IEEE4,False)
	Totalize(1,ShadowbandKJ,IEEE4,False)
	Maximum(1,TrackerWM,IEEE4,False,True)
	Maximum(1,Tracker2WM,IEEE4,False,True)
	Maximum(1,ShadowWM,IEEE4,False,True)
	Maximum(1,SunWM,IEEE4,False,True)
	Maximum(1,ShadowbandWM,IEEE4,False,True)
	Minimum(1,BattV,FP2,False,False)
	Maximum(1,AirTC,FP2,False,False)
	Minimum(1,AirTC,FP2,False,False)
	Maximum(1,RH,FP2,False,False)
	Minimum(1,RH,FP2,False,False)
	WindVector(1,WS_ms,WindDir,FP2,False,0,0,0)
	FieldNames("WS_ms_S_WVT,WindDir_D1_WVT,WindDir_SD1_WVT")
	Maximum(1,BP_mB,FP2,False,False)
	Minimum(1,BP_mB,FP2,False,False)
EndTable

DataTable(Thermocouple,True,-1)
	DataInterval(0,120,Sec,10)
	Average(1,Temp_TypeT,IEEE4,False)
EndTable

DataTable (TPushButton,1,4000)
	Sample(1,PushButton,FP2)
EndTable

'Main Program
BeginProg
	Scan(2,Sec,1,0)
		'Default Datalogger Battery Voltage measurement BattV
		Battery(BattV)
		
		PanelTemp (PTemp,250)
		
	PulseCount (PushButton,1,11,2,0,1.0,0)

	If PushButton >= 1 Then CallTable TPushButton
	
		'CHP1 Pyrheliometer measurements TrackerKJ and TrackerWM  NO1
			VoltDiff(TrackerWM,1,mV250,1,True,0,_50Hz,1,0)
			If TrackerWM<0 Then TrackerWM=0
			TrackerWM=TrackerWM/0.00749
			TrackerKJ=TrackerWM/1000
		
		'CHP1 Pyrheliometer measurements TrackerKJ and TrackerWM   NO2
			VoltDiff(Tracker2WM,1,mV250,6,True,0,_50Hz,1,0)
			If Tracker2WM<0 Then Tracker2WM=0
			Tracker2WM=Tracker2WM/0.00798
			Tracker2KJ=Tracker2WM/1000
		
		'CMP11 Pyranometer measurements ShadowKJ and ShadowWM
			VoltDiff(ShadowWM,1,mV250,2,True,0,_50Hz,1,0)
			If ShadowWM<0 Then ShadowWM=0
			ShadowWM=ShadowWM/0.00921
			ShadowKJ=ShadowWM/1000
				
		'CMP11 Pyranometer measurements SunKJ and SunWM
			VoltDiff(SunWM,1,mV250,3,True,0,_50Hz,1,0)
			If SunWM<0 Then SunWM=0
			SunWM=SunWM/0.00948
			SunKJ=SunWM/1000

		'CMP6 Pyranometer measurements ShadowbandKJ and ShadowbandWM
			VoltDiff(ShadowbandWM,1,mV250,7,True,0,_50Hz,1,0)
			If ShadowbandWM<0 Then ShadowbandWM=0
			ShadowbandWM=ShadowbandWM/0.01426
			ShadowbandKJ=ShadowbandWM/1000
		
		'Type T (copper-constantan) Thermocouple measurements Temp_C
			TCDiff(Temp_TypeT,1,mV2_5C,4,TypeT,PTemp,True,0,_50Hz,1,0)
		
		'CS215 Temperature & Relative Humidity Sensor measurements AirTC and RH
			SDI12Recorder(TRHData(),7,"0","M!",1,0)
		'03001 Wind Speed & Direction Sensor measurements WS_ms and WindDir
			PulseCount(WS_ms,1,1,1,1,0.75,0.2)
			If WS_ms<0.21 Then WS_ms=0
			BrHalf(WindDir,1,mV2500,9,1,1,2500,True,0,_50Hz,355,0)
			If WindDir>=360 Then WindDir=0
		
		'Generic Single-Ended Voltage measurements BP_mB:
			VoltSe(BP_mB,1,mV2500,10,True,0,_50Hz,0.2,600)
		
		'Code to switch SW12 on power up of logger 	
			SW12 (1 )
		'Code to switch SW12 of for one minute a minute after midnight to reset modem
		If IfTime(1,1440,min)
			SW12 (0 )
		EndIf
		If IfTime(2,1440,min) Then 
			SW12 (1 )
		EndIf
		'End of code to switch SW12 
		
		'Call Data Tables and Store Data
			CallTable(TMin)
			CallTable(THour)
			CallTable(TDaily)
			CallTable(Thermocouple)
	NextScan
EndProg
